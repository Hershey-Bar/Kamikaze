# Copy to .env (git-ignored) and fill in. Loaded automatically by mcp_server.py / receiver.py;
# real environment variables always win over values in this file.
SKETCHFAB_TOKEN=
# Poly Pizza key (sent as the X-Auth-Token header to https://api.poly.pizza/v1.1/search/{query}).
POLY_PIZZA_API_KEY=
# Optional: Thingiverse app token for 1:1 phone dummies (https://www.thingiverse.com/developers). Printables and
# Open Food Facts need no key.
THINGIVERSE_TOKEN=
THINGIVERSE_CLIENT_SECRET=
# 1 = also accept NonCommercial-licensed dummies (most Galaxy dummies; private demos only).
KAMIKAZE_CAD_ALLOW_NC=0

# training (default): dashboard shows the live preview frame, enrollment UI is on.
# deployment: no frame is kept in RAM at all (preview disabled).
KAMIKAZE_MODE=training

# Zero-touch kiosk starts even when there are no enrolled classes. Debug keeps the manual enrollment controls.
KAMIKAZE_VIEW=smart
KAMIKAZE_SMART_WINDOW=5.0
KAMIKAZE_SMART_DETECT=0.65

# Hexagon NPU (QNN TFLite delegate). 0 = CPU only. Embedder backend: auto | npu | executorch | torch.
KAMIKAZE_NPU=1
KAMIKAZE_EMBED_BACKEND=auto
# NPU object detector crops the embedding to the phone/can inside the reticle (0 = fixed 75% center crop).
KAMIKAZE_DETECT_CROP=1
# Object detector: Ultralytics YOLO (yolo26n default, yolo11n, or a custom stem exported with ./export_yolo.sh,
# ~6 ms on the HTP) or MediaPipe EfficientDet (lite2 / lite0). KAMIKAZE_DETECT_SCORE = min detection confidence.
KAMIKAZE_DETECTOR=yolo26n
KAMIKAZE_DETECT_SCORE=0.30

# Use a category-level model (generic soda can / smartphone) when no exact or similar CAD match exists.
KAMIKAZE_CAD_GENERIC=1

# Live stream: drop the preview and report 0 fps after this many seconds without a frame; cap for the MJPEG preview.
KAMIKAZE_STALE_S=3.0
KAMIKAZE_STREAM_FPS=30
# RAM cache for static/ files (GLB models, JS), in MB.
KAMIKAZE_ASSET_CACHE_MB=1024
# Optional RAM ring of decoded frames for rewind (GB, training mode only, capped at 60% of RAM). 0 = off (no images kept).
KAMIKAZE_RING_GB=0
