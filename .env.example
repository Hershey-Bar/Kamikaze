# Copy to .env (git-ignored) and fill in. Loaded automatically by mcp_server.py / receiver.py;
# real environment variables always win over values in this file.
SKETCHFAB_TOKEN=
# Poly Pizza key (sent as the X-Auth-Token header to https://api.poly.pizza/v1.1/search/{query}).
POLY_PIZZA_API_KEY=

# training (default): dashboard shows the live preview frame, enrollment UI is on.
# deployment: no frame is kept in RAM at all (preview disabled).
KAMIKAZE_MODE=training

# Hexagon NPU (QNN TFLite delegate). 0 = CPU only. Embedder backend: auto | npu | executorch | torch.
KAMIKAZE_NPU=1
KAMIKAZE_EMBED_BACKEND=auto
# NPU object detector crops the embedding to the phone/can inside the reticle (0 = fixed 60% center crop).
KAMIKAZE_DETECT_CROP=1
# lite2 (more accurate, ~3 ms on HTP) or lite0 (faster).
KAMIKAZE_DETECTOR=lite2

# Use a category-level model (generic soda can / smartphone) when no exact or similar CAD match exists.
KAMIKAZE_CAD_GENERIC=1